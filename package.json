{
  "name": "chrome-slopster",
  "description": "Translate posts and draft replies and new posts on Reddit, X, and Facebook. You review and send everything.",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run compile && npm run lint && npm test && npm run build",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && playwright test",
    "assets:store": "wxt build && node scripts/generate-store-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
